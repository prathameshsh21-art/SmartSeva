# SmartSeva Backend Environment Configuration Template
# Copy to .env or export in your production/staging environment

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/smartseva_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password

# JWT Security Configuration (Must be at least 256 bits / 32 characters)
JWT_SECRET=your_production_256bit_secret_key_change_in_production_min32chars
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# SMTP / Email Notification Configuration (Gmail or any standard SMTP server)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Notification Channels (SMS and WhatsApp use native device/browser deep links; Email uses Gmail SMTP)
SMS_ENABLED=true
WHATSAPP_ENABLED=true

# Temporary Application Credential Encryption Key (AES-256 / 32 bytes minimum for production)
APPLICATION_CREDENTIAL_ENCRYPTION_KEY=your_production_secure_aes_encryption_key_32bytes_min

# CORS Allowed Origins (Comma-separated for multiple domains in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Public Portal Base URL (Used for citizen secure document verification & download links)
PORTAL_BASE_URL=http://localhost:5173

# File Storage Configuration
FILE_STORAGE_ROOT=./uploads